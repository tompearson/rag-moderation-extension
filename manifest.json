{
  "manifest_version": 3,
  "name": "RAG Moderation Assistant",
  "version": "0.2.2",
  "description": "Side panel moderation via Community Moderation Tool (RAG provider).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "clipboardRead",
    "scripting",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.airesearchdog.net/*",
    "https://moderation-tool-universal.vercel.app/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open RAG Moderation",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
